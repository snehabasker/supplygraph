# Copy to .env and adjust. Never commit .env.
SUPPLYGRAPH_DATA_DIR=data

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
# Optional: agent / MCP path tools (`ask --graph`, `mcp --graph`). They always run in READ
# transactions; with Neo4j Enterprise/Aura, also point them at a reader-role account.
# NEO4J_READ_USER=reader
# NEO4J_READ_PASSWORD=change-me-please
# NEO4J_QUERY_TIMEOUT=5

# Claude model for ER adjudication (`resolve --llm`), extraction (`--method llm`) and the agent
# (`ask`, `evaluate-agent`). Credentials come from
# ANTHROPIC_API_KEY or an `ant auth login` profile.
SUPPLYGRAPH_LLM_MODEL=claude-opus-5-5

# SEC EDGAR fair-access policy: identify yourself with a contact email, or www.sec.gov returns 403.
SEC_USER_AGENT=SupplyGraph research you@example.com

# OpenSanctions "sanctions" collection (CC BY-NC 4.0: non-commercial use only)
OPENSANCTIONS_URL=https://data.opensanctions.org/datasets/latest/sanctions/targets.simple.csv

# Optional: pgvector candidate generation for entity resolution (`evaluate-er --vectors`).
# `docker compose up -d --wait pgvector` starts it.
PGVECTOR_PASSWORD=change-me-please
PGVECTOR_DSN=postgresql://supplygraph:change-me-please@localhost:5433/supplygraph

# Optional: MLflow tracking for `evaluate-* --track`. Default: sqlite:///data/mlflow.db
# MLFLOW_TRACKING_URI=http://localhost:5000

# Optional: a different model for the agent-eval judge (`evaluate-agent --judge`).
# SUPPLYGRAPH_JUDGE_MODEL=claude-opus-5-5

# Optional: Celery background jobs (`supplygraph worker`, `supplygraph enqueue`).
# `docker compose up -d --wait redis` starts the broker.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
